# Copy to .env and adjust. Every value here has a safe local-dev default.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Production: postgresql://user:pass@host:5432/dbname — local default is SQLite.
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=reservations@maison-elegance.example
# Dev-only staff password for the demo seed (DEBUG=True only). Leave blank
# to have the seed generate a random one-off password and print it once.
MAISON_DEV_STAFF_PASSWORD=
